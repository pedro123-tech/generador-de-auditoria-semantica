# Plantilla de secrets para desplegar en Streamlit Community Cloud (o
# cualquier host compatible con st.secrets).
#
# NO subas nunca el archivo real "secrets.toml" (ya está en .gitignore).
# Copia este archivo como "secrets.toml" en el servidor de despliegue (o
# pégalo en el panel "Secrets" de Streamlit Cloud) y rellena los valores.

# Obligatoria: API key de Ahrefs.
AHREFS_API_KEY = "..."

# Opcional: API key de IA por defecto (Anthropic/OpenAI/Gemini). Si se deja
# vacía, cada persona puede pegar la suya en la propia interfaz.
IA_API_KEY = ""

# Recomendado si la app la va a usar más de una persona: contraseña de
# acceso compartida por el equipo. Sin esto, CUALQUIERA con el link puede
# usar la app y gastar la cuota de Ahrefs.
APP_PASSWORD = "cambia-esto"

# Opcional: tope de unidades de Ahrefs que se permite consumir en una sola
# ejecución, para proteger la cuota mensual compartida. Por defecto 150000.
MAX_UNITS_PER_RUN = "150000"
