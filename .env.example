# Copia este archivo a ".env" y rellena los valores. El .env NO se sube a git.

# Obligatorias para datos reales (DataForSEO, panel -> API Access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Opcional: key de IA para la categorizacion semantica.
# Puede ser de Anthropic, OpenAI o Gemini (se detecta automaticamente).
IA_API_KEY=

# Recomendado si varias personas van a usar la misma instancia desplegada:
# contraseña de acceso compartida. En local puedes dejarla vacía.
APP_PASSWORD=
